{
  "name": "oj-short",
  "version": "2.0.4",
  "description": "Short commands for oj",
  "author": {
    "name": "e6nlaq",
    "url": "https://github.com/e6nlaq"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e6nlaq/oj-short.git"
  },
  "bugs": {
    "url": "https://github.com/e6nlaq/oj-short/issues"
  },
  "homepage": "https://github.com/e6nlaq/oj-short#readme",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/update-notifier": "^6.0.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "bun run build.ts",
    "format": "biome format --write ./src/**/*.ts",
    "lint:check": "biome check --write ./src/**/*.ts",
    "check:unsafe": "biome check --write --unsafe ./src/**/*.ts",
    "lint": "biome lint ./src/**/*.ts",
    "get": "bun run src/get.ts",
    "subm": "bun run src/subm.ts",
    "prepare": "bunx husky",
    "commitmsg": "commitlint -e $GIT_PARAMS"
  },
  "lint-staged": {
    "./src/**/*.ts": [
      "bun check"
    ]
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "chalk": "^6.0.1",
    "update-notifier": "^7.3.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "get": "src/get.ts",
    "subm": "src/subm.ts"
  },
  "peerDependencies": {
    "commander": "^15.0.0"
  }
}
